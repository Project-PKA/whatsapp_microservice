# Variáveis universais (independem de stack e de tipo de gatilho).
# Copie para .env e preencha os valores locais.

# Ambiente de execução: development | staging | production
ENVIRONMENT=development

# Nome do serviço — usado em logs estruturados e em spans de OpenTelemetry.
SERVICE_NAME=TODO-nome-do-servico

# Nível de log estruturado: debug | info | warn | error
LOG_LEVEL=info

# Endpoint do coletor de OpenTelemetry (ver docs/observability.md).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------
# As variáveis abaixo são decididas na entrevista do BOOTSTRAP.md, de
# acordo com a stack e o tipo de gatilho escolhidos. Descomentar e
# preencher o que for aplicável.
# -----------------------------------------------------------------------

# --- HTTP (se o gatilho for um servidor HTTP) ---
# HTTP_PORT=8080

# --- Fila/evento (se o gatilho for um consumidor) ---
# QUEUE_URL=
# QUEUE_NAME=

# --- Cron (se o gatilho for um worker agendado) ---
# CRON_SCHEDULE="*/5 * * * *"

# --- Banco compartilhado (se este serviço acessar banco de outro repositório) ---
# Ver docs/integration.md para a lista de tabelas/schemas autorizados.
# DATABASE_URL=
