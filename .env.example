# Copie para .env e preencha os valores locais. Nunca commite o .env.

ENVIRONMENT=development
SERVICE_NAME=whatsapp-microservice
LOG_LEVEL=info
HEALTH_PORT=8080

# Banco compartilhado com o Backend, com o papel PRÓPRIO do bot (nunca o do Backend, nunca superusuário).
# Login que pertence ao grupo bot_runtime (migration 0021 do Backend). Ver docs/integration.md.
# Sessão do WhatsApp por loja (credencial: fora do git, com permissão restrita). {store_id} é obrigatório.
# SESSION_DB_TEMPLATE=sessions/{store_id}.sqlite3
# Fotos das cartas: volume SOMENTE LEITURA com o STORAGE_DIR do Backend (D19).
# STORAGE_DIR=/app/storage
# QR no terminal, SÓ para desenvolvimento (o QR dá acesso à conta).
# CONSOLE_QR=true

# DATABASE_URL=postgresql://bot_dev:CHANGE_ME@localhost:5432/app
