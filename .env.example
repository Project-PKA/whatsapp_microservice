# =============================================================================
# Variáveis de ambiente — copie para `.env` e ajuste. Nunca commite o .env real.
#
# A configuração chega em RUNTIME: a mesma imagem roda em dev, test, homolog
# e prod. Variável nova fica em três lugares: aqui, na leitura validada de
# ambiente do código (falhe no boot se faltar) e no GitHub Environment.
# =============================================================================

# --- Universais --------------------------------------------------------------
# Ambiente lógico: local | dev | test | homolog | prod
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json

# Porta do health check auxiliar (/health, /ready), mesmo em worker sem HTTP.
HEALTH_PORT=8080

# --- Observabilidade (docs/observability.md) ---------------------------------
# TODO(bootstrap): nome real do serviço
OTEL_SERVICE_NAME=service-name
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# Decididas no BOOTSTRAP.md, conforme o gatilho. Descomente o que se aplica.
# -----------------------------------------------------------------------------

# --- HTTP ---
# PORT=8080

# --- Fila/evento ---
# QUEUE_URL=
# QUEUE_NAME=
# QUEUE_DLQ_NAME=

# --- Cron ---
# CRON_SCHEDULE="*/5 * * * *"

# --- Banco compartilhado (usuário/role restrito — docs/integration.md) ---
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Somente CI/CD — Secrets/Variables do GitHub (CONVENCOES.md do codex-base, §11):
# AUTOMATION_TOKEN, SONAR_TOKEN, PROJECT_URL (org) · CODEQL_LANGUAGES (repo)
# APP_BASE_URL (environment, smoke test em /health)
# -----------------------------------------------------------------------------
